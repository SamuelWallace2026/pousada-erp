generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Tabela de Quartos
model Quarto {
  id          String    @id @default(uuid())
  numero      String    @unique
  capacidade  Int
  valorDiaria Float
  status      String    @default("LIVRE")
  categoria   String    @default("Padrão")
  reservas    Reserva[]
}

// Tabela de Hóspedes
model Hospede {
  id        String    @id @default(uuid())
  nome      String
  cpf       String    @unique
  email     String?
  telefone  String
  reservas  Reserva[] 
  createdAt DateTime  @default(now())
}

// Tabela de Reservas
model Reserva {
  id           String   @id @default(uuid())
  hospedeId    String
  quartoId     String
  dataCheckIn  DateTime
  dataCheckOut DateTime
  status       String   @default("CONFIRMADA")
  origem       String   @default("Direto")
  
  hospede      Hospede  @relation(fields: [hospedeId], references: [id])
  quarto       Quarto   @relation(fields: [quartoId], references: [id])
  
  consumos     Consumo[]
  transacoes   Transacao[]
  usuarios     Usuario[] // <--- ADICIONADO AQUI PARA RESOLVER A RELAÇÃO DO PRISMA
  
  createdAt    DateTime @default(now())
}

// 1. Tabela para o Login 
model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String   
  cargo     String   // 'GERENTE', 'RECEPCAO', 'COZINHA', 'HOSPEDE'
  
  // Se for hóspede, podemos vincular opcionalmente à reserva dele
  reservaId String?  
  reserva   Reserva? @relation(fields: [reservaId], references: [id], onDelete: SetNull)

  criadoEm  DateTime @default(now())  
}

// 2. Tabela do Cardápio/Frigobar
model Produto {
  id       String    @id @default(uuid())
  nome     String
  preco    Float
  estoque  Int       @default(0)
  consumos Consumo[]
}

// 3. Tabela que vincula o Produto consumido à Reserva do cliente
model Consumo {
  id         String   @id @default(uuid())
  quantidade Int
  subtotal   Float    
  criadoEm   DateTime @default(now())

  reservaId  String
  reserva    Reserva  @relation(fields: [reservaId], references: [id])
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id])
}

// 4. Tabela do Fluxo de Caixa Diário
model Transacao {
  id              String   @id @default(uuid())
  tipo            String   
  valor           Float
  metodoPagamento String   
  descricao       String   
  criadoEm        DateTime @default(now())

  reservaId       String?
  reserva         Reserva? @relation(fields: [reservaId], references: [id])
}