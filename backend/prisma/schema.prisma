generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Tabela de Quartos
model Quarto {
  id          String    @id @default(uuid())
  numero      String    @unique
  capacidade  Int
  valorDiaria Float
  status      String    @default("LIVRE")
  reservas    Reserva[] // Relação: Um quarto pode ter várias reservas
}

// Tabela de Hóspedes
model Hospede {
  id        String    @id @default(uuid())
  nome      String
  cpf       String    @unique
  email     String?
  telefone  String
  reservas  Reserva[] // Relação: Um hóspede pode ter várias reservas
  createdAt DateTime  @default(now())
}

// Tabela de Reservas
model Reserva {
  id           String   @id @default(uuid())
  hospedeId    String
  quartoId     String
  dataCheckIn  DateTime
  dataCheckOut DateTime
  status       String   @default("CONFIRMADA")
  
  // Ligações (Foreign Keys)
  hospede      Hospede  @relation(fields: [hospedeId], references: [id])
  quarto       Quarto   @relation(fields: [quartoId], references: [id])
  
  // --- NOVAS LIGAÇÕES ---
  consumos     Consumo[]
  transacoes   Transacao[]
  
  createdAt    DateTime @default(now())
}

// --- NOVOS MÓDULOS ---

// 1. Tabela para o Login (Etapa 1)
model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String   
  perfil    String   // Ex: "GERENTE" ou "RECEPCIONISTA"
  criadoEm  DateTime @default(now())
}

// 2. Tabela do Cardápio/Frigobar (Etapa 2)
model Produto {
  id        String    @id @default(uuid())
  nome      String
  preco     Float
  estoque   Int       @default(0)
  consumos  Consumo[]
}

// 3. Tabela que vincula o Produto consumido à Reserva do cliente (Etapa 2)
model Consumo {
  id          String   @id @default(uuid())
  quantidade  Int
  subtotal    Float    
  criadoEm    DateTime @default(now())

  reservaId   String
  reserva     Reserva  @relation(fields: [reservaId], references: [id])
  produtoId   String
  produto     Produto  @relation(fields: [produtoId], references: [id])
}

// 4. Tabela do Fluxo de Caixa Diário (Sua Etapa - Etapa 3)
model Transacao {
  id              String   @id @default(uuid())
  tipo            String   // Ex: "ENTRADA" ou "SAIDA"
  valor           Float
  metodoPagamento String   // Ex: "PIX", "CARTAO", "DINHEIRO"
  descricao       String   
  criadoEm        DateTime @default(now())

  reservaId       String?
  reserva         Reserva? @relation(fields: [reservaId], references: [id])
}