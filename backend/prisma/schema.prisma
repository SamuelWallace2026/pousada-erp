// ==========================================
// CONFIGURAÇÃO DO BANCO DE DADOS
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. GESTÃO DE HÓSPEDES
// ==========================================
model Hospede {
  id           String    @id @default(uuid())
  nome         String
  cpf          String    @unique
  email        String?
  telefone     String
  
  preferencias String?
  observacoes  String?
  
  criadoEm     DateTime  @default(now())
  reservas     Reserva[]
}

// ==========================================
// 2. GESTÃO DE QUARTOS & CHALÉS
// ==========================================
model Quarto {
  id            String       @id @default(uuid())
  numero        String       @unique
  capacidade    Int
  valorDiaria   Float
  status        String       @default("LIVRE")
  categoria     String
  
  descricao     String?
  itensInclusos String?
  coordX        Float?
  coordY        Float?
  
  fotos         FotoQuarto[]
  reservas      Reserva[]
}

model FotoQuarto {
  id       String @id @default(uuid())
  url      String
  quartoId String
  quarto   Quarto @relation(fields: [quartoId], references: [id])
}

// ==========================================
// 3. MAPA INTERATIVO
// ==========================================
model AreaLazer {
  id        String  @id @default(uuid())
  nome      String
  descricao String?
  coordX    Float
  coordY    Float
}

// ==========================================
// 4. RESERVAS
// ==========================================
model Reserva {
  id           String    @id @default(uuid())
  hospedeId    String
  quartoId     String
  dataCheckIn  DateTime
  dataCheckOut DateTime
  status       String    @default("CONFIRMADA")
  origem       String    @default("Direto")
  criadoEm     DateTime  @default(now())
  
  hospede      Hospede   @relation(fields: [hospedeId], references: [id])
  quarto       Quarto    @relation(fields: [quartoId], references: [id])
  consumos     Consumo[]
  usuarios     Usuario[] 
}

// ==========================================
// 5. RESTAURANTE E SERVIÇOS EXTRAS
// ==========================================
model Produto {
  id       String    @id @default(uuid())
  nome     String
  preco    Float
  estoque  Int
  categoria String   @default("RESTAURANTE")
  consumos Consumo[]
}

model Consumo {
  id          String   @id @default(uuid())
  reservaId   String
  produtoId   String
  observacoes String?
  status      String   @default("SOLICITADO")
  quantidade  Int
  subtotal    Float
  criadoEm    DateTime @default(now())
  
  reserva     Reserva  @relation(fields: [reservaId], references: [id])
  produto     Produto  @relation(fields: [produtoId], references: [id])
}

// ==========================================
// 6. FINANCEIRO (CAIXA)
// ==========================================
model Transacao {
  id              String   @id @default(uuid())
  tipo            String
  valor           Float
  metodoPagamento String
  descricao       String
  criadoEm        DateTime @default(now())
}

// ==========================================
// 7. SEGURANÇA E ACESSO (PERFIS)
// ==========================================
model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  cargo     String
  reservaId String?
  criadoEm  DateTime @default(now())
  
  reserva   Reserva? @relation(fields: [reservaId], references: [id])
}

// ==========================================
// 8. RESTAURANTE (MESAS E EVENTOS)
// ==========================================
model ReservaMesa {
  id         String   @id @default(uuid())
  nome       String
  data       String
  hora       String
  qtdPessoas Int
  mesa       String
  status     String   @default("CONFIRMADA")
  criadoEm   DateTime @default(now())
}

model EventoRestaurante {
  id        String   @id @default(uuid())
  titulo    String
  data      String
  hora      String
  descricao String
  tipo      String   @default("Especial")
  criadoEm  DateTime @default(now())
}

// ==========================================
// 9. GESTÃO OPERACIONAL
// ==========================================
model TarefaLimpeza {
  id          String   @id @default(uuid())
  quarto      String
  tipo        String
  observacao  String?
  status      String   @default("Sujo")
  urgente     Boolean  @default(false)
  responsavel String?
  criadoEm    DateTime @default(now())
}

model ChamadoManutencao {
  id               String   @id @default(uuid())
  local            String
  descricao        String
  prioridade       String   @default("Baixa")
  tempoEspera      String?
  status           String   @default("Pendente")
  hospedeEnvolvido String?
  criadoEm         DateTime @default(now())
}

// ==========================================
// 10. MENSAGENS (CHAT DA RECEPÇÃO)
// ==========================================
model Mensagem {
  id        String   @id @default(uuid())
  remetente String
  conteudo  String
  resposta  String?  // Suporte à resposta da recepção
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now())
}