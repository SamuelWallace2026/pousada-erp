// ==========================================
// CONFIGURAÇÃO DO BANCO DE DADOS
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Pode ser alterado para "postgresql" ou "mysql" na produção
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. GESTÃO DE HÓSPEDES
// ==========================================
model Hospede {
  id           String    @id @default(uuid())
  nome         String
  cpf          String    @unique
  email        String?
  telefone     String
  
  // Cadastro Avançado
  preferencias String?   // Ex: Cama extra, travesseiro de penas
  observacoes  String?   // Ex: Alergia a frutos do mar, check-in tardio
  
  criadoEm     DateTime  @default(now())
  reservas     Reserva[]
}

// ==========================================
// 2. GESTÃO DE QUARTOS & CHALÉS
// ==========================================
model Quarto {
  id            String       @id @default(uuid())
  numero        String       @unique
  capacidade    Int
  valorDiaria   Float
  status        String       @default("LIVRE")
  categoria     String
  
  // Detalhamento e Mapa Interativo
  descricao     String?      // Descrição detalhada do ambiente
  itensInclusos String?      // Ex: "Ar-condicionado, TV Smart, Frigobar"
  coordX        Float?       // Eixo X para o Mapa Interativo
  coordY        Float?       // Eixo Y para o Mapa Interativo
  
  fotos         FotoQuarto[] // Relacionamento com a Galeria
  reservas      Reserva[]
}

// Galeria de Fotos por Acomodação
model FotoQuarto {
  id       String @id @default(uuid())
  url      String
  quartoId String
  quarto   Quarto @relation(fields: [quartoId], references: [id])
}

// ==========================================
// 3. MAPA INTERATIVO DA POUSADA
// ==========================================
model AreaLazer {
  id        String  @id @default(uuid())
  nome      String  // Ex: "Piscina Principal", "Recepção", "Estacionamento"
  descricao String?
  coordX    Float   // Eixo X no mapa
  coordY    Float   // Eixo Y no mapa
}

// ==========================================
// 4. RESERVAS
// ==========================================
model Reserva {
  id           String    @id @default(uuid())
  hospedeId    String
  quartoId     String
  dataCheckIn  DateTime
  dataCheckOut DateTime
  status       String    @default("CONFIRMADA")
  origem       String    @default("Direto")
  criadoEm     DateTime  @default(now())
  
  hospede      Hospede   @relation(fields: [hospedeId], references: [id])
  quarto       Quarto    @relation(fields: [quartoId], references: [id])
  consumos     Consumo[]
  usuarios     Usuario[] 
}

// ==========================================
// 5. RESTAURANTE E SERVIÇOS EXTRAS
// ==========================================
model Produto {
  id        String    @id @default(uuid())
  nome      String
  preco     Float
  estoque   Int
  
  // Diferenciação de serviços
  categoria String    @default("RESTAURANTE") // Ex: "RESTAURANTE", "CAFE_EXTRA", "PASSEIO"
  
  consumos  Consumo[]
}

model Consumo {
  id          String   @id @default(uuid())
  reservaId   String
  produtoId   String
  observacoes String?
  status      String   @default("SOLICITADO") // "SOLICITADO", "EM_PREPARO", "PRONTO", "ENTREGUE"
  quantidade  Int
  subtotal    Float
  criadoEm    DateTime @default(now())
  
  reserva     Reserva  @relation(fields: [reservaId], references: [id])
  produto     Produto  @relation(fields: [produtoId], references: [id])
}

// ==========================================
// 6. FINANCEIRO (CAIXA)
// ==========================================
model Transacao {
  id              String   @id @default(uuid())
  tipo            String
  valor           Float
  metodoPagamento String
  descricao       String
  criadoEm        DateTime @default(now())
}

// ==========================================
// 7. SEGURANÇA E ACESSO (PERFIS)
// ==========================================
model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String   // Salva o Hash gerado pelo Bcrypt
  cargo     String
  reservaId String?
  criadoEm  DateTime @default(now())
  
  reserva   Reserva? @relation(fields: [reservaId], references: [id])
}

// ==========================================
// 8. RESTAURANTE (MESAS E EVENTOS)
// ==========================================
model ReservaMesa {
  id         String   @id @default(uuid())
  nome       String
  data       String
  hora       String
  qtdPessoas Int
  mesa       String
  status     String   @default("CONFIRMADA")
  criadoEm   DateTime @default(now())
}

model EventoRestaurante {
  id        String   @id @default(uuid())
  titulo    String
  data      String
  hora      String
  descricao String
  tipo      String   @default("Especial") // Ex: "Especial", "Privado", "Música ao Vivo"
  criadoEm  DateTime @default(now())
}

// ==========================================
// 9. GESTÃO OPERACIONAL (GOVERNANÇA E MANUTENÇÃO)
// ==========================================
model TarefaLimpeza {
  id          String   @id @default(uuid())
  quarto      String
  tipo        String
  observacao  String?
  status      String   @default("Sujo") // "Sujo", "Em Limpeza", "Limpo", "Bloqueado"
  urgente     Boolean  @default(false)
  responsavel String?
  criadoEm    DateTime @default(now())
}

model ChamadoManutencao {
  id               String   @id @default(uuid())
  local            String
  descricao        String
  prioridade       String   @default("Baixa") // "Alta", "Média", "Baixa"
  tempoEspera      String?
  status           String   @default("Pendente") // "Pendente", "Em Andamento", "Concluído"
  hospedeEnvolvido String?
  criadoEm         DateTime @default(now())
}